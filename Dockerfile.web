# Webréteg: a dashboard és a widget lefordítása, majd Caddy-vel kiszolgálása.

# --- build ---
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY dashboard/package.json dashboard/
COPY widget/package.json widget/
RUN npm ci
COPY dashboard dashboard
COPY widget widget
RUN npm run build

# --- run ---
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# Építéskor megbukik, ha a Caddyfile hibás
RUN TICKOFF_SITE_ADDRESS=example.com TICKOFF_ACME_EMAIL=admin@example.com caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
COPY --from=build /app/dashboard/dist /srv/dashboard
COPY --from=build /app/widget/dist/tickoff-widget.js /srv/widget/tickoff-widget.js
