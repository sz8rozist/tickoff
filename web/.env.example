# Adatbázis (MySQL 8 vagy MySQL-kompatibilis szolgáltató). Helyben a docker-compose "mysql-web" szolgáltatása.
DATABASE_URL=mysql://tickoff:tickoff@localhost:3308/tickoff

# JWT-titok (legalább 32 karakter). Élesben kötelezően saját érték!
TICKOFF_JWT_SECRET=dev-only-secret-change-me-in-production-32b

# A dashboard nyilvános címe (a levelekben szereplő linkekhez)
DASHBOARD_ORIGIN=http://localhost:3000

# Képernyőképek és mellékletek helye (fájlrendszer, Dockerben kötet)
TICKOFF_STORAGE_DIR=./data/screenshots

# E-mail (SMTP). Nélküle a levelek nem mennek el. Fejlesztéshez a Mailpit: SMTP_HOST=127.0.0.1 (nem localhost: az IPv6-ra oldódhat), SMTP_PORT=1025
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# TICKOFF_MAIL_FROM=Tickoff <no-reply@localhost>
