{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "react": [
        "preact/compat"
      ],
      "react-dom": [
        "preact/compat"
      ],
      "react/jsx-runtime": [
        "preact/jsx-runtime"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
