# Production beállítások. Másold .env néven (cp .env.example .env), és töltsd ki.
# A .env fájlt SOHA ne commitold (a .gitignore kizárja).
#
# Erős titkok generálása:  openssl rand -base64 36

# A weboldal címe, ahogy a Caddy kapja (hostname, a DNS-nek erre a szerverre kell mutatnia).
# Egy hostname esetén automatikus HTTPS (Let's Encrypt), ehhez a 80-as és a 443-as port elérhető kell legyen.
TICKOFF_SITE_ADDRESS=app.pelda.hu
# Ugyanez teljes URL-ként (séma + host): a levelekben szereplő linkekhez
TICKOFF_PUBLIC_URL=https://app.pelda.hu
# E-mail a Let's Encrypt lejárati értesítésekhez (kötelező)
TICKOFF_ACME_EMAIL=admin@pelda.hu

# Adatbázis jelszavak
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# A bejelentkezési tokenek aláírása. Legalább 32 karakter, véletlenszerű. Ha megváltoztatod, mindenki kilép.
# Korábbi (Java) üzemből való átálláskor ugyanazt az értéket add meg, akkor a felhasználók bejelentkezve maradnak.
TICKOFF_JWT_SECRET=

# Nyilvános regisztráció. A saját fiókod létrehozása után állítsd false-ra, és indítsd újra az alkalmazást.
TICKOFF_REGISTRATION_ENABLED=true

# Időzóna az exportokhoz és az összefoglaló e-mailek időzítéséhez (reggel 8-kor mennek)
TICKOFF_EXPORT_ZONE=Europe/Budapest

# E-mail: a jelszó-visszaállításhoz, a megerősítéshez és az értesítésekhez SMTP-szerver kell (pl. Brevo, Mailgun,
# Amazon SES, a hosting szolgáltatód). SMTP_HOST nélkül a levelek nem mennek el: ilyenkor az elfelejtett jelszó
# nem állítható vissza, és nincs értesítés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# A feladó. A domainnek egyeznie kell azzal, amit az SMTP-szolgáltatód engedélyez (SPF/DKIM), különben spamként érkezik.
TICKOFF_MAIL_FROM=Tickoff <no-reply@app.pelda.hu>

# Portok (csak akkor kell módosítani, ha más szolgáltatás foglalja a 80-ast / 443-ast)
HTTP_PORT=80
HTTPS_PORT=443
