# Production beállítások. Másold .env néven (cp .env.example .env), és töltsd ki.
# A .env fájlt SOHA ne commitold (a .gitignore kizárja).
#
# Erős titkok generálása:  openssl rand -base64 36

# A weboldal címe, ahogy a Caddy kapja (hostname, a DNS-nek erre a szerverre kell mutatnia).
# Egy hostname esetén automatikus HTTPS (Let's Encrypt), ehhez a 80-as és a 443-as port elérhető kell legyen.
TICKOFF_SITE_ADDRESS=app.pelda.hu
# Ugyanez teljes URL-ként (séma + host), a backend CORS-hoz
TICKOFF_PUBLIC_URL=https://app.pelda.hu
# E-mail a Let's Encrypt lejárati értesítésekhez (kötelező)
TICKOFF_ACME_EMAIL=admin@pelda.hu

# Adatbázis jelszavak
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# A bejelentkezési tokenek aláírása. Legalább 32 karakter, véletlenszerű. Ha megváltoztatod, mindenki kilép.
TICKOFF_JWT_SECRET=

# Nyilvános regisztráció. A saját fiókod létrehozása után állítsd false-ra, és indítsd újra a backendet.
TICKOFF_REGISTRATION_ENABLED=true

# Portok (csak akkor kell módosítani, ha más szolgáltatás foglalja a 80-ast / 443-ast)
HTTP_PORT=80
HTTPS_PORT=443
